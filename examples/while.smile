REM SMILE v0.8.0 WHILE example

LET Limit = 0
LET Count = 1
LET Total = 0
LET Row = 1
LET Column = 1

PRINT Enter a positive loop count:
INPUT Limit

// The condition is tested before the first iteration and after every SET.
WHILE Count <= Limit
    SET Total = Total + Count

    IF Count = 1 THEN
        PRINT First iteration: Count={Count}, Total={Total}
    ELSE
        PRINT Next iteration: Count={Count}, Total={Total}
    END IF

    SET Count = Count + 1
END WHILE

PRINT Counter loop finished with Total={Total}.

// Nested loops reuse variables declared before either WHILE body.
WHILE Row <= 2
    SET Column = 1

    WHILE Column <= 2
        PRINT Grid={Row},{Column}
        SET Column = Column + 1
    END WHILE

    SET Row = Row + 1
END WHILE
