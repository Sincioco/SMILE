' Lantern Maze: an original pellet-collecting text game.

Option Explicit

Const WIDTH = 71
Const HEIGHT = 21
Const EMPTY = 0
Const WALL = 1
Const PELLET = 2
Const GATE = 3
Const TUNNEL_ROW = 10
Const ENEMY_COUNT = 4
Const DIRECTION_COUNT = 4
Const ENEMY_DELAY = 220
Const RELEASE_DELAY = 700

Dim Maze[WIDTH, HEIGHT] As Number
Dim DirectionX[DIRECTION_COUNT] As Number
Dim DirectionY[DIRECTION_COUNT] As Number

Dim PlayerX As Number
Dim PlayerY As Number
Dim PlayerPreviousX As Number
Dim PlayerPreviousY As Number
Dim PlayerDirection As Number

Dim EnemyX[ENEMY_COUNT] As Number
Dim EnemyY[ENEMY_COUNT] As Number
Dim EnemyPreviousX[ENEMY_COUNT] As Number
Dim EnemyPreviousY[ENEMY_COUNT] As Number
Dim EnemyDirection[ENEMY_COUNT] As Number
Dim EnemyReleaseTime[ENEMY_COUNT] As Number
Dim EnemyVisits[ENEMY_COUNT, WIDTH * HEIGHT] As Number

Dim PelletsLeft As Number
Dim Score As Number
Dim Lives As Number
Dim KeyCode As Number
Dim NextEnemyTime As Number
Dim ProgramRunning As Boolean
Dim RoundActive As Boolean
Dim PlayerWon As Boolean
Dim NeedsRedraw As Boolean
Dim X As Number
Dim Y As Number

ProgramRunning = True
Call InitializeDirections()
Call ShowTitle()

Do
    Get Key KeyCode

    If KeyCode = KEY_ESCAPE Then
        ProgramRunning = False
    Else If KeyCode = KEY_ENTER Then
        Call ResetGame()
        Text Color Default
        Clear Screen
        Call DrawMaze()

        Do
            NeedsRedraw = False
            Call ReadPlayerMove()

            If ProgramRunning And RoundActive And Timer() >= NextEnemyTime Then
                Call MoveEnemies()
                NextEnemyTime = Timer() + ENEMY_DELAY
            End If

            If ProgramRunning And RoundActive Then
                Call CheckCollision()

                If NeedsRedraw Then
                    Call DrawMaze()
                End If
            End If

            Wait 20 Milliseconds
        Loop Until Not ProgramRunning Or Not RoundActive

        If ProgramRunning Then
            Call EndRound()
        End If
    End If

    Wait 20 Milliseconds
Loop Until Not ProgramRunning

Text Color Default
Clear Screen
Text Color Cyan, Black
Print "The lanterns dim. Thanks for exploring!"
Text Color Default

Sub InitializeDirections()

    DirectionX[0] = 0
    DirectionY[0] = -1
    DirectionX[1] = 1
    DirectionY[1] = 0
    DirectionX[2] = 0
    DirectionY[2] = 1
    DirectionX[3] = -1
    DirectionY[3] = 0

End Sub

Sub ShowTitle()

    Text Color Default
    Clear Screen
    Text Color Yellow, Black
    Print "LANTERN MAZE"
    Text Color Cyan, Black
    Print "Light every passage while four clever shadows search for you."
    Text Color White, Black
    Print "Move with WASD or arrows. Side tunnels wrap across the maze."
    Print "Press Enter to begin. Press Escape to leave."
    Text Color Default

End Sub

Sub ResetGame()

    Call BuildMaze()
    PlayerX = 35
    PlayerY = 15
    PlayerPreviousX = PlayerX
    PlayerPreviousY = PlayerY
    PlayerDirection = 1
    Call ResetEnemies()
    Call ClearPellet(PlayerX, PlayerY)
    Score = 0
    Lives = 3
    PlayerWon = False
    RoundActive = True
    NextEnemyTime = Timer() + ENEMY_DELAY

End Sub

Sub ResetEnemies()

    Dim Cell As Number
    Dim Enemy As Number
    Dim Now As Number

    EnemyX[0] = 32
    EnemyY[0] = 10
    EnemyX[1] = 34
    EnemyY[1] = 10
    EnemyX[2] = 36
    EnemyY[2] = 10
    EnemyX[3] = 38
    EnemyY[3] = 10
    Now = Timer()

    For Enemy = 0 To ENEMY_COUNT - 1
        EnemyPreviousX[Enemy] = EnemyX[Enemy]
        EnemyPreviousY[Enemy] = EnemyY[Enemy] + 1
        EnemyDirection[Enemy] = 0
        EnemyReleaseTime[Enemy] = Now + Enemy * RELEASE_DELAY
        Call ClearPellet(EnemyX[Enemy], EnemyY[Enemy])

        For Cell = 0 To WIDTH * HEIGHT - 1
            EnemyVisits[Enemy, Cell] = 0
        End For

        EnemyVisits[Enemy, CellIndex(EnemyX[Enemy], EnemyY[Enemy])] = 1
    End For

End Sub

Sub BuildMaze()

    PelletsLeft = 0

    For Y = 0 To HEIGHT - 1
        For X = 0 To WIDTH - 1
            If X = 0 Or X = WIDTH - 1 Or Y = 0 Or Y = HEIGHT - 1 Then
                Maze[X, Y] = WALL
            Else
                Maze[X, Y] = PELLET
                PelletsLeft = PelletsLeft + 1
            End If
        End For
    End For

    ' The paired wall islands make a broad, symmetric arcade maze.
    Call PutWallBlock(3, 2, 11, 3)
    Call PutWallBlock(59, 2, 67, 3)
    Call PutWallBlock(15, 2, 27, 3)
    Call PutWallBlock(43, 2, 55, 3)
    Call PutWallBlock(33, 1, 37, 4)

    Call PutWallBlock(3, 6, 7, 8)
    Call PutWallBlock(63, 6, 67, 8)
    Call PutWallBlock(11, 6, 21, 7)
    Call PutWallBlock(49, 6, 59, 7)
    Call PutWallBlock(25, 6, 30, 7)
    Call PutWallBlock(40, 6, 45, 7)

    Call PutWallBlock(3, 12, 7, 14)
    Call PutWallBlock(63, 12, 67, 14)
    Call PutWallBlock(11, 13, 21, 14)
    Call PutWallBlock(49, 13, 59, 14)
    Call PutWallBlock(25, 13, 30, 14)
    Call PutWallBlock(40, 13, 45, 14)

    Call PutWallBlock(3, 17, 11, 18)
    Call PutWallBlock(59, 17, 67, 18)
    Call PutWallBlock(15, 17, 27, 18)
    Call PutWallBlock(43, 17, 55, 18)
    Call PutWallBlock(33, 17, 37, 19)

    Call BuildGhostHouse()
    Maze[0, TUNNEL_ROW] = EMPTY
    Maze[WIDTH - 1, TUNNEL_ROW] = EMPTY

End Sub

Sub BuildGhostHouse()

    For X = 29 To 41
        Call PutWall(X, 8)
        Call PutWall(X, 12)
    End For

    For Y = 9 To 11
        Call PutWall(29, Y)
        Call PutWall(41, Y)
    End For

    For Y = 9 To 11
        For X = 30 To 40
            Call ClearPellet(X, Y)
        End For
    End For

    Call PutGate(34, 8)
    Call PutGate(35, 8)
    Call PutGate(36, 8)

End Sub

Sub PutWallBlock(StartX As Number, StartY As Number, EndX As Number, EndY As Number)

    Dim CellX As Number
    Dim CellY As Number

    For CellY = StartY To EndY
        For CellX = StartX To EndX
            Call PutWall(CellX, CellY)
        End For
    End For

End Sub

Sub PutWall(CellX As Number, CellY As Number)

    Call ClearPellet(CellX, CellY)
    Maze[CellX, CellY] = WALL

End Sub

Sub PutGate(CellX As Number, CellY As Number)

    Call ClearPellet(CellX, CellY)
    Maze[CellX, CellY] = GATE

End Sub

Sub ClearPellet(CellX As Number, CellY As Number)

    If Maze[CellX, CellY] = PELLET Then
        Maze[CellX, CellY] = EMPTY
        PelletsLeft = PelletsLeft - 1
    End If

End Sub

Sub ReadPlayerMove()

    Dim Direction As Number
    Dim NextX As Number
    Dim NextY As Number

    Get Key KeyCode
    Direction = -1

    If KeyCode = KEY_ESCAPE Then
        ProgramRunning = False
    Else If KeyCode = KEY_W Or KeyCode = KEY_UP Then
        Direction = 0
    Else If KeyCode = KEY_D Or KeyCode = KEY_RIGHT Then
        Direction = 1
    Else If KeyCode = KEY_S Or KeyCode = KEY_DOWN Then
        Direction = 2
    Else If KeyCode = KEY_A Or KeyCode = KEY_LEFT Then
        Direction = 3
    End If

    PlayerPreviousX = PlayerX
    PlayerPreviousY = PlayerY

    If Direction >= 0 Then
        NextX = NextCellX(PlayerX, PlayerY, Direction)
        NextY = PlayerY + DirectionY[Direction]

        If PlayerCanEnter(NextX, NextY) Then
            PlayerX = NextX
            PlayerY = NextY
            PlayerDirection = Direction
            NeedsRedraw = True
        End If
    End If

    If Maze[PlayerX, PlayerY] = PELLET Then
        Call ClearPellet(PlayerX, PlayerY)
        Score = Score + 5

        If PelletsLeft = 0 Then
            PlayerWon = True
            RoundActive = False
        End If
    End If

End Sub

Function PlayerCanEnter(CellX As Number, CellY As Number) As Boolean

    Dim CanEnter As Boolean

    CanEnter = False

    If CellX >= 0 And CellX < WIDTH And CellY >= 0 And CellY < HEIGHT Then
        CanEnter = Maze[CellX, CellY] <> WALL And Maze[CellX, CellY] <> GATE
    End If

    Return CanEnter

End Function

Function NextCellX(CellX As Number, CellY As Number, Direction As Number) As Number

    Dim Result As Number

    Result = CellX + DirectionX[Direction]

    If CellY = TUNNEL_ROW And Result < 0 Then
        Result = WIDTH - 1
    Else If CellY = TUNNEL_ROW And Result >= WIDTH Then
        Result = 0
    End If

    Return Result

End Function

Sub MoveEnemies()

    Dim Enemy As Number
    Dim Now As Number

    Now = Timer()

    For Enemy = 0 To ENEMY_COUNT - 1
        If Now >= EnemyReleaseTime[Enemy] Then
            Call MoveOneEnemy(Enemy)
        End If
    End For

End Sub

Sub MoveOneEnemy(Enemy As Number)

    Dim Direction As Number
    Dim NextX As Number
    Dim NextY As Number
    Dim VisitCell As Number

    Direction = ChooseEnemyDirection(Enemy)

    If Direction >= 0 Then
        EnemyPreviousX[Enemy] = EnemyX[Enemy]
        EnemyPreviousY[Enemy] = EnemyY[Enemy]
        NextX = NextCellX(EnemyX[Enemy], EnemyY[Enemy], Direction)
        NextY = EnemyY[Enemy] + DirectionY[Direction]
        EnemyX[Enemy] = NextX
        EnemyY[Enemy] = NextY
        EnemyDirection[Enemy] = Direction
        VisitCell = CellIndex(NextX, NextY)
        EnemyVisits[Enemy, VisitCell] = EnemyVisits[Enemy, VisitCell] + 1
        NeedsRedraw = True
    End If

End Sub

Function ChooseEnemyDirection(Enemy As Number) As Number

    Dim BestDirection As Number
    Dim BestScore As Number
    Dim Candidate As Number
    Dim CandidateX As Number
    Dim CandidateY As Number
    Dim Distance As Number
    Dim LegalMoves As Number
    Dim Opposite As Number
    Dim ScoreForMove As Number
    Dim TargetX As Number
    Dim TargetY As Number
    Dim VisitCell As Number

    BestDirection = -1
    BestScore = 1000000
    LegalMoves = CountEnemyMoves(Enemy)
    Opposite = (EnemyDirection[Enemy] + 2) Mod DIRECTION_COUNT
    TargetX = EnemyTargetX(Enemy)
    TargetY = EnemyTargetY(Enemy)

    For Candidate = 0 To DIRECTION_COUNT - 1
        If EnemyCanMove(Enemy, Candidate) Then
            CandidateX = NextCellX(EnemyX[Enemy], EnemyY[Enemy], Candidate)
            CandidateY = EnemyY[Enemy] + DirectionY[Candidate]

            If LegalMoves = 1 Or Candidate <> Opposite Then
                Distance = Abs(CandidateX - TargetX) + Abs(CandidateY - TargetY)
                ScoreForMove = Distance * 10
                VisitCell = CellIndex(CandidateX, CandidateY)
                ScoreForMove = ScoreForMove + Min(30, EnemyVisits[Enemy, VisitCell] * 4)
                ScoreForMove = ScoreForMove + (Candidate + Enemy) Mod DIRECTION_COUNT

                If ScoreForMove < BestScore Then
                    BestScore = ScoreForMove
                    BestDirection = Candidate
                End If
            End If
        End If
    End For

    If BestDirection < 0 And EnemyCanMove(Enemy, Opposite) Then
        BestDirection = Opposite
    End If

    Return BestDirection

End Function

Function CountEnemyMoves(Enemy As Number) As Number

    Dim Candidate As Number
    Dim MoveCount As Number

    MoveCount = 0

    For Candidate = 0 To DIRECTION_COUNT - 1
        If EnemyCanMove(Enemy, Candidate) Then
            MoveCount = MoveCount + 1
        End If
    End For

    Return MoveCount

End Function

Function EnemyCanMove(Enemy As Number, Direction As Number) As Boolean

    Dim CanMove As Boolean
    Dim NextX As Number
    Dim NextY As Number

    CanMove = False
    NextX = NextCellX(EnemyX[Enemy], EnemyY[Enemy], Direction)
    NextY = EnemyY[Enemy] + DirectionY[Direction]

    If NextX >= 0 And NextX < WIDTH And NextY >= 0 And NextY < HEIGHT Then
        CanMove = Maze[NextX, NextY] <> WALL
    End If

    Return CanMove

End Function

Function EnemyTargetX(Enemy As Number) As Number

    Dim SideDirection As Number
    Dim Target As Number

    If EnemyX[Enemy] >= 30 And EnemyX[Enemy] <= 40 And EnemyY[Enemy] >= 9 And EnemyY[Enemy] <= 11 Then
        Target = 35
    Else
        Target = PlayerX

        Select Case Enemy
            Case 1
                Target = PlayerX + DirectionX[PlayerDirection] * 4

            Case 2
                SideDirection = (PlayerDirection + 1) Mod DIRECTION_COUNT
                Target = PlayerX + DirectionX[PlayerDirection] * 2 + DirectionX[SideDirection] * 4

            Case 3
                If (Timer() / 5000) Mod 2 = 1 Then
                    Target = WIDTH - 2
                End If
        End Select
    End If

    Return Min(WIDTH - 1, Max(0, Target))

End Function

Function EnemyTargetY(Enemy As Number) As Number

    Dim SideDirection As Number
    Dim Target As Number

    If EnemyX[Enemy] >= 30 And EnemyX[Enemy] <= 40 And EnemyY[Enemy] >= 9 And EnemyY[Enemy] <= 11 Then
        Target = 7
    Else
        Target = PlayerY

        Select Case Enemy
            Case 1
                Target = PlayerY + DirectionY[PlayerDirection] * 4

            Case 2
                SideDirection = (PlayerDirection + 1) Mod DIRECTION_COUNT
                Target = PlayerY + DirectionY[PlayerDirection] * 2 + DirectionY[SideDirection] * 4

            Case 3
                If (Timer() / 5000) Mod 2 = 1 Then
                    Target = HEIGHT - 2
                End If
        End Select
    End If

    Return Min(HEIGHT - 1, Max(0, Target))

End Function

Function CellIndex(CellX As Number, CellY As Number) As Number

    Return CellY * WIDTH + CellX

End Function

Sub CheckCollision()

    Dim Collided As Boolean
    Dim Enemy As Number

    Collided = False

    For Enemy = 0 To ENEMY_COUNT - 1
        If PlayerX = EnemyX[Enemy] And PlayerY = EnemyY[Enemy] Then
            Collided = True
        Else If PlayerX = EnemyPreviousX[Enemy] And PlayerY = EnemyPreviousY[Enemy] Then
            If PlayerPreviousX = EnemyX[Enemy] And PlayerPreviousY = EnemyY[Enemy] Then
                Collided = True
            End If
        End If
    End For

    If Collided Then
        Lives = Lives - 1
        NeedsRedraw = True

        If Lives <= 0 Then
            RoundActive = False
        Else
            PlayerX = 35
            PlayerY = 15
            PlayerPreviousX = PlayerX
            PlayerPreviousY = PlayerY
            Call ResetEnemies()
        End If
    End If

End Sub

Function MazeSymbolAt(CellX As Number, CellY As Number) As Text

    Dim Symbol As Text

    Symbol = " "

    If Maze[CellX, CellY] = WALL Then
        Symbol = "#"
    Else If Maze[CellX, CellY] = PELLET Then
        Symbol = "."
    Else If Maze[CellX, CellY] = GATE Then
        Symbol = "="
    End If

    Return Symbol

End Function

Function EnemySymbol(Enemy As Number) As Text

    Dim Symbol As Text

    Symbol = "D"

    Select Case Enemy
        Case 0
            Symbol = "A"

        Case 1
            Symbol = "B"

        Case 2
            Symbol = "C"
    End Select

    Return Symbol

End Function

Sub UseEnemyColor(Enemy As Number)

    Select Case Enemy
        Case 0
            Text Color Red, Black

        Case 1
            Text Color Magenta, Black

        Case 2
            Text Color Cyan, Black

        Case Else
            Text Color Green, Black
    End Select

End Sub

Sub DrawMaze()

    Dim Enemy As Number

    Dim Rows[HEIGHT] As Text

    ' Prepare the complete base frame before replacing anything on screen.
    For Y = 0 To HEIGHT - 1
        Rows[Y] = ""

        For X = 0 To WIDTH - 1
            Rows[Y] = Rows[Y] + MazeSymbolAt(X, Y)
        End For
    End For

    Move Cursor To 1, 1
    Text Color Yellow, Black
    Print "LANTERN MAZE  Score: "; Score; "  Lives: "; Lives; "  Dots: "; PelletsLeft; "                "
    Text Color Blue, Black

    For Y = 0 To HEIGHT - 1
        Print Rows[Y]
    End For

    Text Color Yellow, Black
    Move Cursor To PlayerX + 1, PlayerY + 2
    Print "@";

    For Enemy = 0 To ENEMY_COUNT - 1
        Call UseEnemyColor(Enemy)
        Move Cursor To EnemyX[Enemy] + 1, EnemyY[Enemy] + 2
        Print EnemySymbol(Enemy);
    End For

    Move Cursor To 1, HEIGHT + 2
    Text Color White, Black
    Print "WASD/arrows move · wrap through side tunnels · Escape exits                  "
    Text Color Default

End Sub

Sub EndRound()

    Call DrawMaze()
    Move Cursor To 1, HEIGHT + 3
    Text Color Yellow, Black

    If PlayerWon Then
        Print "Every passage is bright! Score: "; Score
    Else
        Print "The shadows found the last lantern. Score: "; Score
    End If

    Text Color White, Black
    Print "Press Enter to explore again or Escape to leave.";
    Text Color Default

End Sub
