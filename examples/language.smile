' SMILE Core BASIC 2.1 cumulative language reference.
' Apostrophe comments may use their own line or follow a statement.

Enum Direction
    None
    Left = -1
    Right = 1
End Enum

Type ScoreEntry
    Player As Text
    Points As Number
End Type

Const ProductName = "SMILE"
Const Quotation = "She said ""Hello""."
Const BoardWidth = 4
Const BoardHeight = 3

Dim FirstName As Text
Dim LastName As Text
Dim Age As Number
Dim Ready As Boolean
Dim FullName As Text
Dim Adult As Boolean
Dim WorkingAge As Boolean
Dim Total As Number
Dim Grouped As Number
Dim Quotient As Number
Dim Remainder As Number
Dim Grade As Text
Dim Sum As Number
Dim Counter As Number
Dim Outer As Number
Dim Tally As Number
Dim Inner As Number

Dim SampleValues[3] As Number

Dim SamplePosition As Number

Dim Board[BoardWidth, BoardHeight] As Text

Dim LastKey As Number
Dim FixedRoll As Number
Dim StartedAt As Number
Dim Speed As Double

Dim Measurements[2] As Double

Dim FileBytes[16] As Number

Dim FileByteCount As Number
Dim BestScore As Number
Dim DataStatus As Number
Dim Heading As Direction
Dim CurrentEntry As ScoreEntry
Dim SavedEntry As ScoreEntry

FirstName = "Sin"
LastName = "Cioco"
Age = 49
Ready = True

FullName = FirstName + " " + LastName
Adult = Age >= 18
WorkingAge = Adult And Not False
Total = 2 + 3 * 4
Grouped = (2 + 3) * 4
Quotient = -7 / 2
Remainder = -7 Mod 2

Print
Print ProductName; " Core BASIC"
Print Quotation
Print "Name="; FullName
Print "Age="; Age; ", Adult="; Adult
Print "Arithmetic="; Total; ", "; Grouped; ", "; Quotient; ", "; Remainder
Print "This line ";
Print "was printed by two statements."

If Ready And WorkingAge Then
    Grade = "Ready"
Else If Adult Then
    Grade = "Adult"
Else
    Grade = "Learner"
End If

Print "Branch="; Grade

Sum = 0

For Counter = 1 To 3
    Sum = Sum + Counter
End For

Print "Ascending sum="; Sum

For Counter = 3 Down To 1
    Print Counter;
End For

Print

For Outer = 1 To 3
    Do
        Print "Typed Exit For at "; Outer
        Exit For
    Loop
End For

Tally = 0

Do
    Tally = Tally + 1
Loop Until Tally = 2

Print "Post-tested Do count="; Tally

Do
    Print "Exit Do"
    Exit Do
Loop

Call StoreSample(0, 5)
Call StoreSample(1, 8)
Call StoreSample(2, 13)
Print "Array total="; SampleTotal()

Select Case SampleTotal()
    Case 26
        Print "Select Case matched a constant value."

    Case Else
        Print "Select Case used its fallback."
End Select

Board[1, 1] = "@"
Clear Screen
Move Cursor To 1, 1
Text Color Cyan, Black
Get Key LastKey
StartedAt = Timer()
Wait 0 Milliseconds
Random FixedRoll From 6 To 6
Print "2D cell="; Board[1, 1]
Print "No-input key="; LastKey; ", die="; FixedRoll
Print "Extra key codes="; KEY_O; ", "; KEY_BACKTICK; ", "; KEY_PLUS; ", "; KEY_MINUS
Print "Math="; Abs(-5); ", "; Min(8, 3); ", "; Max(8, 3)
Print "Timer monotonic="; Timer() >= StartedAt
Text Color Default

Print "Unicode scalar count="; Text_Length("A😀B")
Print "Emoji scalar="; Text_Code_At("A😀B", 1)
Print "Text slice="; Text_Slice("A😀B", 1, 1)
Print "Unary plus="; +Age

Speed = ToDouble(3) / 2.0
Measurements[0] = Speed
Measurements[1] = Text_To_Double("2.5e0")
Print "Double values="; Measurements[0]; ", "; Measurements[1]
Print "Double math="; Sqrt(9.0); ", "; Round(2.5); ", "; Clamp(Speed, 0.0, 1.0)
Print "Explicit truncation="; ToNumber(-3.9)
Print "Signed zero="; Text_From_Double(-0.0)

' Put lesson.txt beside the generated executable to read its UTF-8 bytes.
' A missing file safely returns zero bytes.
Load Text File "lesson.txt" Into FileBytes Count FileByteCount
Print "Text-file bytes="; FileByteCount

' Integer saves survive later runs of the same source filename.
Load BestScore From "reference-best" Default 0
BestScore = Max(BestScore, 100)
Save BestScore To "reference-best"
Print "Saved best score="; BestScore

' Data preserves byte arrays and reports recoverable storage outcomes.
FileBytes[0] = 72
FileBytes[1] = 105
Save Data FileBytes Count 2 To "reference-bytes" Status DataStatus
Load Data "reference-bytes" Into FileBytes Count FileByteCount Status DataStatus
Print "Saved bytes="; FileByteCount; ", status="; DataStatus

Heading = Direction.Left
Print "Enum comparison="; Heading = Direction.Left

Select Case Heading
    Case Direction.Left
        Print "The enum selected Left."

    Case Else
        Print "The enum selected another direction."
End Select

CurrentEntry.Player = "Sin"
CurrentEntry.Points = 10
SavedEntry = CurrentEntry
Call AddPoint(CurrentEntry.Points)
Print "Record copies="; SavedEntry.Points; ", "; CurrentEntry.Points

With CurrentEntry
    .Points = .Points + 1
    Print "With record="; .Player; ":"; .Points
End With

Call ShowGreeting()
Call ShowGreeting(Caption:="Welcome", Learner:="Sin")

Call AddPoint(Age)
Call AddPoint(SampleValues[0])
Print "ByRef changed caller storage="; Age; ", "; SampleValues[0]

Print "End Program stops before the next statement."
End Program
Print "unreachable"

Sub StoreSample(ByVal SamplePosition As Number, ByVal Value As Number)

    SampleValues[SamplePosition] = Value

End Sub

Function SampleTotal() As Number

    Dim Position As Number
    Dim Result As Number

    For Position = 0 To 2
        Result = Result + SampleValues[Position]
    End For

    Return Result

End Function

Sub ShowGreeting(
    Optional Learner As Text = "student",
    Optional Caption As Text = "Hello"
)

    Print Caption; ", "; Learner

End Sub

Sub AddPoint(ByRef Value As Number)

    Value = Value + 1

End Sub
