LET FirstName = "Sin"
LET LastName = "Cioco"
LET FullName = FirstName + " " + LastName
LET Greeting = $"Hello {FullName}!"
LET Quote = "She said \"Hello\"."
LET Path = "C:\\SMILE"
LET Age = 49
LET Negative = -12
LET Total = 2 + 3 * 4
LET Grouped = (2 + 3) * 4
LET Quotient = -7 / 2
LET Enabled = TRUE
LET Adult = Age >= 18
LET WorkingAge = Adult AND NOT FALSE
LET SameName = FullName = "Sin Cioco"
LET MixedMessage = $"{FullName}: Age={Age}, Adult={Adult}"

PRINT
PRINT "Quoted literal"
PRINT Raw template keeps C:\SMILE literally.
PRINT Literal braces: {{Name}}
PRINT $"Interpolated greeting: {Greeting}"
PRINT "Concat: " + FirstName + " " + LastName
PRINT {FullName}
PRINT {Age}
PRINT {Negative}
PRINT {Total}
PRINT {Grouped}
PRINT {Quotient}
PRINT {Enabled}
PRINT {WorkingAge}
PRINT {SameName}
PRINT {MixedMessage}
PRINT 2 + 3 = {2 + 3}
PRINT Adult check: {Age >= 18}
PRINT Quote: {Quote}
PRINT Path: {Path}
PRINT {Greeting}

PRINT ""
PRINT FirstName
PRINT {FirstName}
PRINT "FirstName remains literal here: {FirstName}"
PRINT $"Literal braces remain literal: {{FirstName}}"
PRINT A; B; C

PRINT
PRINT SET statement examples in language.smile:

SET FirstName = "Louiery"
set lastname="Cioco"
SET LastName = LastName
SET FullName    =    FirstName + " " + LastName
SET Greeting = $"Hello {FullName}!"
SET Quote = Greeting
SET Path = "D:\\SMILE\\Examples"

SET Age = 50
SET Age = Age + 1
SET Negative = -Age
SET Total = (2 + 3) * 4
SET Grouped = Total
SET Quotient = Total / 3

SET Enabled = FALSE
SET Enabled = NOT Enabled
SET Adult = Age >= 18
SET WorkingAge = Adult
SET WorkingAge = WorkingAge AND Enabled
SET SameName = FullName = "Louiery Cioco"

SET MixedMessage = $"{FullName}: Age={Age}, Adult={Adult}"

SET MixedMessage ="
Block String Literal reassigned with SET:
  Quotes remain text: "Hello".
  Braces remain text: {FullName}
  Escapes work: tab=\t and path=C:\\SMILE

Blank content lines remain blank.
"

SET Quote = "
    The closing quote removes this four-space margin.
      These two extra spaces remain.
    "

PRINT
PRINT Values after SET:
PRINT {Greeting}
PRINT Path: {Path}
PRINT Age={Age}, Negative={Negative}
PRINT Total={Total}, Grouped={Grouped}, Quotient={Quotient}
PRINT Enabled={Enabled}, Adult={Adult}, WorkingAge={WorkingAge}
PRINT SameName={SameName}
PRINT {MixedMessage}
PRINT {Quote}

PRINT
PRINT "SET, PRINT, and LET together:"

LET Score = 10
PRINT Score starts at {Score}.

SET Score = Score + 5
PRINT Score after SET is {Score}.

LET Bonus = Score / 3
PRINT Bonus declared from the updated score is {Bonus}.

SET Score = Score + Bonus
LET Passed = Score >= 18
LET FinalResult = $"Final score: {Score}; bonus: {Bonus}; passed: {Passed}"
PRINT {FinalResult}

SET Passed = NOT Passed
PRINT Toggled passed={Passed}.

SET Greeting = Greeting + " Welcome to SMILE."
LET FinalGreeting = Greeting
LET NextAge = Age + 1
LET EitherFlag = Enabled OR FALSE
LET LiteralPlaceholder = $"Use {{Name}} as a placeholder."

PRINT {FinalGreeting}
PRINT Next age: {NextAge}
PRINT Either flag: {EitherFlag}
PRINT {LiteralPlaceholder}

PRINT
PRINT "IF, ELSE IF, and ELSE statement examples:"

LET IfScore = 85
LET IfReady = TRUE
LET IfGrade = ""
LET IfMessage = ""
LET IfNestedResult = ""

IF IfScore >= 80 THEN
    PRINT Simple IF selected because the score is at least 80.
END IF

IF IfReady = TRUE THEN
    PRINT IF and ELSE selected the ready branch.
ELSE
    PRINT IF and ELSE selected the not-ready branch.
END IF

IF IfScore >= 90 AND IfReady = TRUE THEN
    SET IfGrade = "A"
ELSE IF IfScore >= 80 AND IfReady = TRUE THEN
    SET IfGrade = "B"
ELSE IF IfScore >= 70 AND IfReady = TRUE THEN
    SET IfGrade = "C"
ELSE
    SET IfGrade = "Below C"
END IF

IF (IfScore >= 80 AND IfReady = TRUE) OR IfGrade = "A" THEN
    PRINT Compound IF conditions require a comparison in every leaf.
END IF

IF NOT (IfReady = FALSE) THEN
    IF IfGrade = "B" THEN
        SET IfNestedResult = "Nested IF selected Grade B."
    ELSE
        SET IfNestedResult = "Nested IF selected another grade."
    END IF
END IF

IF IfGrade = "B" THEN
    SET IfMessage ="
    Grade B
    Ready for the next lesson.
    "
ELSE
    SET IfMessage = "Unexpected grade"
END IF

PRINT Grade={IfGrade}
PRINT {IfNestedResult}
PRINT {IfMessage}

REM Full-line comments and source layout examples:
rem REM is case-insensitive.
rEm This mixed-case marker is also a comment.
// C-family-style full-line comment.
# Script-language-style full-line comment.
-- SQL, Ada, and Haskell-style full-line comment.

LET REM = "REM remains a valid variable name."
LET CommentBranch = ""
LET CommentLayoutMessage = ""



IF REM = "REM remains a valid variable name." THEN
    // Comments and blank lines remain in their IF branch.

    SET CommentBranch = "Comments preserve source order."
ELSE
    # This fallback remains present in generated source.

    SET CommentBranch = "Unexpected comment branch."
END IF

IF CommentBranch = "Comments preserve source order." THEN
    -- A comment may precede a nested IF.
    IF REM = "REM remains a valid variable name." THEN
        Rem Nested REM comments are valid.
        SET CommentBranch = CommentBranch + " Nested comments work too."
    END IF
END IF

SET CommentLayoutMessage ="
REM Block String data

// Block String data
# Block String data
-- Block String data
"

PRINT
PRINT "Full-line comments and source layout preservation:"
PRINT {REM}
PRINT {CommentBranch}
PRINT // This text is printed
PRINT # This text is printed
PRINT -- This text is printed
PRINT REM This text is printed
PRINT https://example.com
PRINT {CommentLayoutMessage}

PRINT
PRINT "INPUT statement examples in language.smile:"

LET InputName = ""
LET InputAge = 0
LET InputReady = FALSE

// Each INPUT reads one complete line into an existing fixed-type variable.
PRINT Enter your name:
INPUT InputName

PRINT Enter your age:
INPUT InputAge

PRINT Enter TRUE or FALSE:
INPUT InputReady

PRINT Name=[{InputName}]

IF InputAge >= 18 THEN
    PRINT INPUT age group=Adult
ELSE
    PRINT INPUT age group=Minor
END IF

IF InputReady = TRUE THEN
    PRINT INPUT ready=TRUE
ELSE
    PRINT INPUT ready=FALSE
END IF

PRINT
PRINT "WHILE statement examples in language.smile:"

LET LoopCount = 1

// WHILE tests its condition before every iteration.
WHILE LoopCount <= 3
    PRINT LoopCount={LoopCount}
    SET LoopCount = LoopCount + 1
END WHILE

PRINT WHILE finished at LoopCount={LoopCount}.

PRINT
PRINT "LET and SET Block String Literal examples:"

// LET declares and initializes multiline text without a placeholder assignment.
LET MultilineText = "
    Hello World!
    This is SMILE!
        How are you?
"

PRINT {MultilineText}

// The same variable may later receive another complete Block String value.
SET MultilineText = "
    SET replaces the complete multiline value.
        Exact extra indentation remains.
"

PRINT {MultilineText}

LET LoopBlockMessage = ""
LET LoopBlockCount = 0

// A finite literal assignment remains bounded inside genuine WHILE control flow.
WHILE LoopBlockCount < 2
    SET LoopBlockMessage = "
        Block String assigned inside WHILE.
    "
    PRINT {LoopBlockMessage}
    SET LoopBlockCount = LoopBlockCount + 1
END WHILE
