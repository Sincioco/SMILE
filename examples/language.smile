' SMILE Core BASIC 2.1 cumulative language reference.
' Apostrophe comments may use their own line or follow a statement.

Const ProductName = "SMILE"
Const Quotation = "She said ""Hello""."
Const BoardWidth = 4
Const BoardHeight = 3

Dim FirstName As Text
Dim LastName As Text
Dim Age As Number
Dim Ready As Boolean
Dim FullName As Text
Dim Adult As Boolean
Dim WorkingAge As Boolean
Dim Total As Number
Dim Grouped As Number
Dim Quotient As Number
Dim Remainder As Number
Dim Grade As Text
Dim Sum As Number
Dim Counter As Number
Dim Outer As Number
Dim Tally As Number
Dim Inner As Number

Dim SampleValues[3] As Number

Dim SamplePosition As Number

Dim Board[BoardWidth, BoardHeight] As Text

Dim LastKey As Number
Dim FixedRoll As Number
Dim StartedAt As Number

FirstName = "Sin"
LastName = "Cioco"
Age = 49
Ready = True

FullName = FirstName + " " + LastName
Adult = Age >= 18
WorkingAge = Adult And Not False
Total = 2 + 3 * 4
Grouped = (2 + 3) * 4
Quotient = -7 / 2
Remainder = -7 Mod 2

Print
Print ProductName; " Core BASIC"
Print Quotation
Print "Name="; FullName
Print "Age="; Age; ", Adult="; Adult
Print "Arithmetic="; Total; ", "; Grouped; ", "; Quotient; ", "; Remainder
Print "This line ";
Print "was printed by two statements."

If Ready And WorkingAge Then
    Grade = "Ready"
Else If Adult Then
    Grade = "Adult"
Else
    Grade = "Learner"
End If

Print "Branch="; Grade

Sum = 0

For Counter = 1 To 3
    Sum = Sum + Counter
End For

Print "Ascending sum="; Sum

For Counter = 3 Down To 1
    Print Counter;
End For

Print

For Outer = 1 To 3
    Do
        Print "Typed Exit For at "; Outer
        Exit For
    Loop
End For

Tally = 0

Do
    Tally = Tally + 1
Loop Until Tally = 2

Print "Post-tested Do count="; Tally

Do
    Print "Exit Do"
    Exit Do
Loop

Call StoreSample(0, 5)
Call StoreSample(1, 8)
Call StoreSample(2, 13)
Print "Array total="; SampleTotal()

Select Case SampleTotal()
    Case 26
        Print "Select Case matched a constant value."

    Case Else
        Print "Select Case used its fallback."
End Select

Board[1, 1] = "@"
Clear Screen
Get Key LastKey
StartedAt = Timer()
Wait 0 Milliseconds
Random FixedRoll From 6 To 6
Print "2D cell="; Board[1, 1]
Print "No-input key="; LastKey; ", die="; FixedRoll
Print "Math="; Abs(-5); ", "; Min(8, 3); ", "; Max(8, 3)
Print "Timer monotonic="; Timer() >= StartedAt

Print "End Program stops before the next statement."
End Program
Print "unreachable"

Sub StoreSample(ByVal SamplePosition As Number, ByVal Value As Number)

    SampleValues[SamplePosition] = Value

End Sub

Function SampleTotal() As Number

    Dim Position As Number
    Dim Result As Number

    For Position = 0 To 2
        Result = Result + SampleValues[Position]
    End For

    Return Result

End Function
