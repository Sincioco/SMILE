' Trail Runner: an original continuous text-board game.

Option Explicit

Const WIDTH = 60
Const HEIGHT = 17
Const MAX_LENGTH = 870
Const MOVE_DELAY = 110

Dim SnakeX[MAX_LENGTH] As Number
Dim SnakeY[MAX_LENGTH] As Number

Dim SnakeLength As Number
Dim DirectionX As Number
Dim DirectionY As Number
Dim FoodX As Number
Dim FoodY As Number
Dim Score As Number
Dim NextMoveTime As Number
Dim KeyCode As Number
Dim ProgramRunning As Boolean
Dim RoundActive As Boolean
Dim AteFood As Boolean
Dim X As Number
Dim Y As Number

ProgramRunning = True
Call ShowTitle()

Do
    Get Key KeyCode

    If KeyCode = KEY_ESCAPE Then
        ProgramRunning = False
    Else If KeyCode = KEY_ENTER Then
        Call ResetGame()
        Text Color Default
        Clear Screen
        Call DrawBoard()

        Do
            Call ReadControls()

            If ProgramRunning And RoundActive And Timer() >= NextMoveTime Then
                Call MoveSnake()
                NextMoveTime = Timer() + MOVE_DELAY

                If RoundActive Then
                    Call DrawBoard()
                End If
            End If

            Wait 20 Milliseconds
        Loop Until Not ProgramRunning Or Not RoundActive

        If ProgramRunning Then
            Call EndRound()
        End If
    End If

    Wait 20 Milliseconds
Loop Until Not ProgramRunning

Text Color Default
Clear Screen
Text Color Cyan, Black
Print "Thanks for running the trail!"
Text Color Default

Sub ShowTitle()

    Text Color Default
    Clear Screen
    Text Color Yellow, Black
    Print "TRAIL RUNNER"
    Text Color Green, Black
    Print "Guide the growing trail with WASD or the arrow keys."
    Text Color White, Black
    Print "Avoid the border and your own path."
    Print "Press Enter to start. Press Escape to leave."
    Text Color Default

End Sub

Sub ResetGame()

    Dim Index As Number

    SnakeLength = 3
    DirectionX = 1
    DirectionY = 0
    Score = 0
    RoundActive = True

    For Index = 0 To MAX_LENGTH - 1
        SnakeX[Index] = 0
        SnakeY[Index] = 0
    End For

    SnakeX[0] = 5
    SnakeY[0] = HEIGHT / 2
    SnakeX[1] = 4
    SnakeY[1] = HEIGHT / 2
    SnakeX[2] = 3
    SnakeY[2] = HEIGHT / 2
    Call SpawnFood()
    NextMoveTime = Timer()

End Sub

Sub ReadControls()

    Get Key KeyCode

    If KeyCode = KEY_ESCAPE Then
        ProgramRunning = False
    Else If (KeyCode = KEY_W Or KeyCode = KEY_UP) And DirectionY <> 1 Then
        DirectionX = 0
        DirectionY = -1
    Else If (KeyCode = KEY_S Or KeyCode = KEY_DOWN) And DirectionY <> -1 Then
        DirectionX = 0
        DirectionY = 1
    Else If (KeyCode = KEY_A Or KeyCode = KEY_LEFT) And DirectionX <> 1 Then
        DirectionX = -1
        DirectionY = 0
    Else If (KeyCode = KEY_D Or KeyCode = KEY_RIGHT) And DirectionX <> -1 Then
        DirectionX = 1
        DirectionY = 0
    End If

End Sub

Sub MoveSnake()

    Dim NextX As Number
    Dim NextY As Number
    Dim Index As Number

    NextX = SnakeX[0] + DirectionX
    NextY = SnakeY[0] + DirectionY

    If NextX <= 0 Or NextX >= WIDTH - 1 Or NextY <= 0 Or NextY >= HEIGHT - 1 Then
        RoundActive = False
        Return
    End If

    If ContainsSnake(NextX, NextY) Then
        RoundActive = False
        Return
    End If

    AteFood = NextX = FoodX And NextY = FoodY

    If AteFood And SnakeLength < MAX_LENGTH Then
        SnakeLength = SnakeLength + 1
    End If

    For Index = SnakeLength - 1 Down To 1
        SnakeX[Index] = SnakeX[Index - 1]
        SnakeY[Index] = SnakeY[Index - 1]
    End For

    SnakeX[0] = NextX
    SnakeY[0] = NextY

    If AteFood Then
        Score = Score + 10
        Call SpawnFood()
    End If

End Sub

Function ContainsSnake(CellX As Number, CellY As Number) As Boolean

    Dim Index As Number
    Dim Found As Boolean

    Found = False

    For Index = 0 To SnakeLength - 1
        If SnakeX[Index] = CellX And SnakeY[Index] = CellY Then
            Found = True
            Exit For
        End If
    End For

    Return Found

End Function

Sub SpawnFood()

    Dim Attempt As Number
    Dim Found As Boolean

    Found = False

    For Attempt = 1 To 100
        Random FoodX From 1 To WIDTH - 2
        Random FoodY From 1 To HEIGHT - 2

        If Not ContainsSnake(FoodX, FoodY) Then
            Found = True
            Exit For
        End If
    End For

    If Not Found Then
        For Y = 1 To HEIGHT - 2
            For X = 1 To WIDTH - 2
                If Not Found And Not ContainsSnake(X, Y) Then
                    FoodX = X
                    FoodY = Y
                    Found = True
                End If
            End For
        End For
    End If

    If Not Found Then
        RoundActive = False
    End If

End Sub

Function SymbolAt(CellX As Number, CellY As Number) As Text

    Dim Index As Number
    Dim Symbol As Text

    Symbol = " "

    If CellX = 0 Or CellX = WIDTH - 1 Or CellY = 0 Or CellY = HEIGHT - 1 Then
        Symbol = "#"
    Else If CellX = FoodX And CellY = FoodY Then
        Symbol = "*"
    Else
        For Index = SnakeLength - 1 Down To 0
            If SnakeX[Index] = CellX And SnakeY[Index] = CellY Then
                If Index = 0 Then
                    Symbol = "@"
                Else
                    Symbol = "o"
                End If
            End If
        End For
    End If

    Return Symbol

End Function

Sub DrawBoard()

    Dim Rows[HEIGHT] As Text

    ' Keep the old frame visible while preparing the next one.
    For Y = 0 To HEIGHT - 1
        Rows[Y] = ""

        For X = 0 To WIDTH - 1
            Rows[Y] = Rows[Y] + SymbolAt(X, Y)
        End For
    End For

    Move Cursor To 1, 1
    Text Color Yellow, Black
    Print "TRAIL RUNNER    Score: "; Score; "    Length: "; SnakeLength; "                          "
    Text Color Green, Black

    For Y = 0 To HEIGHT - 1
        Print Rows[Y]
    End For

    Text Color Red, Black
    Move Cursor To FoodX + 1, FoodY + 2
    Print "*";
    Text Color Yellow, Black
    Move Cursor To SnakeX[0] + 1, SnakeY[0] + 2
    Print "@";
    Move Cursor To 1, HEIGHT + 2
    Text Color White, Black
    Print "WASD/arrows move · Escape exits                              "
    Text Color Default

End Sub

Sub EndRound()

    Call DrawBoard()
    Move Cursor To 1, HEIGHT + 3
    Text Color Yellow, Black
    Print "Trail ended. Final score: "; Score
    Text Color White, Black
    Print "Press Enter to run again or Escape to leave.";
    Text Color Default

End Sub
