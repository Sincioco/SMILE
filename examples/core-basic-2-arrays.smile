Option Explicit

Const ArrayLength = 4

Dim Numbers[ArrayLength] As Number
Dim Labels[ArrayLength] As Text
Dim Enabled[ArrayLength] As Boolean
Dim Position As Number

For Position = 0 To ArrayLength - 1
    Numbers[Position] = Position * Position
    Labels[Position] = "item"
    Enabled[Position] = Position Mod 2 = 0
End For

For Position = 0 To ArrayLength - 1
    Print Position; ": "; Numbers[Position]; ", "; Labels[Position]; ", "; Enabled[Position]
End For

End Program
