Option Explicit

Dim Score As Number
Dim Band As Text
Dim Passed As Boolean

Score = 2
Band = "blue"
Passed = True

Select Case Score
    Case 1
        Print "one"

    Case 2
        Print "two"

    Case Else
        Print "another number"
End Select

Select Case Band
    Case "red"
        Print "red band"

    Case "blue"
        Print "blue band"

    Case Else
        Print "another band"
End Select

Select Case Passed
    Case True
        Print "passed"

    Case False
        Print "not passed"
End Select

End Program
