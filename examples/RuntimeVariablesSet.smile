LET Counter = 0
LET Name = ""
LET Ready = FALSE

SET Name ="
S
 I
  N
"

PRINT Counter={Counter}, Ready={Ready}
PRINT Name:
PRINT {Name}

SET Counter = Counter + 1
SET Name = "Louiery"
SET Ready = TRUE

PRINT Counter={Counter}, Name={Name}, Ready={Ready}

SET Counter = Counter + 2
LET Message = $"{Name} finished with {Counter}."
PRINT {Message}
