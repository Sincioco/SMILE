REM SMILE v0.7.0 INPUT example

LET Name = ""
LET Age = 0
LET Ready = FALSE

PRINT Enter your name:
INPUT Name

PRINT Enter your age:
INPUT Age

PRINT Enter TRUE or FALSE:
INPUT Ready

PRINT Name=[{Name}]

IF Age >= 18 THEN
    PRINT Age group=Adult
ELSE
    PRINT Age group=Minor
END IF

IF Ready = TRUE THEN
    PRINT Ready=TRUE
ELSE
    PRINT Ready=FALSE
END IF
