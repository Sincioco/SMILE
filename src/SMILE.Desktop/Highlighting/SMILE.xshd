<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="SMILE" extensions=".smile" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
  <Color name="String" foreground="#A31515" />
  <Color name="Comment" foreground="#008000" fontStyle="italic" />
  <Color name="Number" foreground="#00008B" />
  <Color name="Operator" foreground="#1F1F1F" />

  <RuleSet ignoreCase="true">
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="Comment" begin="'" end="$" />

    <Keywords color="Keyword">
      <Word>PRINT</Word>
      <Word>TRUE</Word>
      <Word>FALSE</Word>
      <Word>NOT</Word>
      <Word>AND</Word>
      <Word>OR</Word>
      <Word>IF</Word>
      <Word>THEN</Word>
      <Word>ELSE</Word>
      <Word>END</Word>
      <Word>DIM</Word>
      <Word>AS</Word>
      <Word>NUMBER</Word>
      <Word>BOOLEAN</Word>
      <Word>TEXT</Word>
      <Word>CONST</Word>
      <Word>MOD</Word>
      <Word>FOR</Word>
      <Word>TO</Word>
      <Word>DOWN</Word>
      <Word>DO</Word>
      <Word>LOOP</Word>
      <Word>UNTIL</Word>
      <Word>EXIT</Word>
      <Word>PROGRAM</Word>
      <Word>OPTION</Word>
      <Word>EXPLICIT</Word>
      <Word>SUB</Word>
      <Word>FUNCTION</Word>
      <Word>CALL</Word>
      <Word>RETURN</Word>
      <Word>SELECT</Word>
      <Word>CASE</Word>
      <Word>BYVAL</Word>
      <Word>GET</Word>
      <Word>KEY</Word>
      <Word>CLEAR</Word>
      <Word>SCREEN</Word>
      <Word>WAIT</Word>
      <Word>MILLISECONDS</Word>
      <Word>RANDOM</Word>
      <Word>FROM</Word>
      <Word>TIMER</Word>
      <Word>ABS</Word>
      <Word>MIN</Word>
      <Word>MAX</Word>
      <Word>KEY_NONE</Word>
      <Word>KEY_W</Word>
      <Word>KEY_A</Word>
      <Word>KEY_S</Word>
      <Word>KEY_D</Word>
      <Word>KEY_UP</Word>
      <Word>KEY_DOWN</Word>
      <Word>KEY_LEFT</Word>
      <Word>KEY_RIGHT</Word>
      <Word>KEY_ENTER</Word>
      <Word>KEY_ESCAPE</Word>
      <Word>KEY_SPACE</Word>
      <Word>KEY_1</Word>
      <Word>KEY_2</Word>
      <Word>KEY_3</Word>
      <Word>KEY_4</Word>
      <Word>KEY_TAB</Word>
      <Word>KEY_OTHER</Word>
    </Keywords>

    <Rule color="Number">\b\d+\b</Rule>
    <Rule color="Operator">&lt;&gt;|&lt;=|&gt;=|[=+\-*/();\[\],&lt;&gt;]</Rule>
  </RuleSet>
</SyntaxDefinition>
