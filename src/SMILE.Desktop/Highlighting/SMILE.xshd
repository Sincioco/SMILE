<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="SMILE" extensions=".smile" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
  <Color name="String" foreground="#A31515" />
  <Color name="Comment" foreground="#008000" fontStyle="italic" />
  <Color name="Number" foreground="#00008B" />
  <Color name="Operator" foreground="#1F1F1F" />

  <RuleSet ignoreCase="true">
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="Comment" begin="'" end="$" />

    <Keywords color="Keyword">
      <Word>PRINT</Word>
      <Word>TRUE</Word>
      <Word>FALSE</Word>
      <Word>NOT</Word>
      <Word>AND</Word>
      <Word>OR</Word>
      <Word>IF</Word>
      <Word>THEN</Word>
      <Word>ELSE</Word>
      <Word>END</Word>
      <Word>DIM</Word>
      <Word>AS</Word>
      <Word>NUMBER</Word>
      <Word>BOOLEAN</Word>
      <Word>TEXT</Word>
      <Word>CONST</Word>
      <Word>MOD</Word>
      <Word>FOR</Word>
      <Word>TO</Word>
      <Word>DOWN</Word>
      <Word>DO</Word>
      <Word>LOOP</Word>
      <Word>UNTIL</Word>
      <Word>EXIT</Word>
      <Word>PROGRAM</Word>
      <Word>OPTION</Word>
      <Word>EXPLICIT</Word>
      <Word>SUB</Word>
      <Word>FUNCTION</Word>
      <Word>CALL</Word>
      <Word>RETURN</Word>
      <Word>SELECT</Word>
      <Word>CASE</Word>
      <Word>BYVAL</Word>
    </Keywords>

    <Rule color="Number">\b\d+\b</Rule>
    <Rule color="Operator">&lt;&gt;|&lt;=|&gt;=|[=+\-*/();\[\],&lt;&gt;]</Rule>
  </RuleSet>
</SyntaxDefinition>
