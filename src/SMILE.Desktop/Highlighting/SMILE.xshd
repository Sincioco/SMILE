<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="SMILE" extensions=".smile" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
  <Color name="String" foreground="#A31515" />
  <Color name="Comment" foreground="#008000" fontStyle="italic" />
  <Color name="Number" foreground="#00008B" />
  <Color name="Operator" foreground="#1F1F1F" />

  <RuleSet ignoreCase="true">
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="Comment" begin="'" end="$" />

    <Keywords color="Keyword">
      <Word>PRINT</Word>
      <Word>TRUE</Word>
      <Word>FALSE</Word>
      <Word>NOT</Word>
      <Word>AND</Word>
      <Word>OR</Word>
      <Word>IF</Word>
      <Word>THEN</Word>
      <Word>ELSE</Word>
      <Word>END</Word>
      <Word>DIM</Word>
      <Word>AS</Word>
      <Word>NUMBER</Word>
      <Word>DOUBLE</Word>
      <Word>TODOUBLE</Word>
      <Word>TONUMBER</Word>
      <Word>CLAMP</Word>
      <Word>SQRT</Word>
      <Word>SIN</Word>
      <Word>COS</Word>
      <Word>ATAN2</Word>
      <Word>FLOOR</Word>
      <Word>CEILING</Word>
      <Word>TRUNCATE</Word>
      <Word>ROUND</Word>
      <Word>TEXT_FROM_DOUBLE</Word>
      <Word>TEXT_TO_DOUBLE</Word>
      <Word>BOOLEAN</Word>
      <Word>TEXT</Word>
      <Word>CONST</Word>
      <Word>MOD</Word>
      <Word>FOR</Word>
      <Word>TO</Word>
      <Word>DOWN</Word>
      <Word>DO</Word>
      <Word>LOOP</Word>
      <Word>UNTIL</Word>
      <Word>EXIT</Word>
      <Word>PROGRAM</Word>
      <Word>OPTION</Word>
      <Word>EXPLICIT</Word>
      <Word>SUB</Word>
      <Word>FUNCTION</Word>
      <Word>CALL</Word>
      <Word>RETURN</Word>
      <Word>SELECT</Word>
      <Word>CASE</Word>
      <Word>BYVAL</Word>
      <Word>BYREF</Word>
      <Word>OPTIONAL</Word>
      <Word>LOAD</Word>
      <Word>FILE</Word>
      <Word>INTO</Word>
      <Word>COUNT</Word>
      <Word>GET</Word>
      <Word>KEY</Word>
      <Word>CLEAR</Word>
      <Word>SCREEN</Word>
      <Word>MOVE</Word>
      <Word>CURSOR</Word>
      <Word>COLOR</Word>
      <Word>DEFAULT</Word>
      <Word>BLACK</Word>
      <Word>RED</Word>
      <Word>GREEN</Word>
      <Word>YELLOW</Word>
      <Word>BLUE</Word>
      <Word>MAGENTA</Word>
      <Word>CYAN</Word>
      <Word>WHITE</Word>
      <Word>WAIT</Word>
      <Word>MILLISECONDS</Word>
      <Word>RANDOM</Word>
      <Word>FROM</Word>
      <Word>TIMER</Word>
      <Word>ABS</Word>
      <Word>MIN</Word>
      <Word>MAX</Word>
      <Word>TEXT_LENGTH</Word>
      <Word>TEXT_CODE_AT</Word>
      <Word>TEXT_SLICE</Word>
      <Word>KEY_NONE</Word>
      <Word>KEY_W</Word>
      <Word>KEY_A</Word>
      <Word>KEY_S</Word>
      <Word>KEY_D</Word>
      <Word>KEY_UP</Word>
      <Word>KEY_DOWN</Word>
      <Word>KEY_LEFT</Word>
      <Word>KEY_RIGHT</Word>
      <Word>KEY_ENTER</Word>
      <Word>KEY_ESCAPE</Word>
      <Word>KEY_SPACE</Word>
      <Word>KEY_1</Word>
      <Word>KEY_2</Word>
      <Word>KEY_3</Word>
      <Word>KEY_4</Word>
      <Word>KEY_O</Word>
      <Word>KEY_F</Word>
      <Word>KEY_G</Word>
      <Word>KEY_R</Word>
      <Word>KEY_P</Word>
      <Word>KEY_B</Word>
      <Word>KEY_CONTROL</Word>
      <Word>KEY_BACKTICK</Word>
      <Word>KEY_X</Word>
      <Word>KEY_Y</Word>
      <Word>KEY_Z</Word>
      <Word>KEY_E</Word>
      <Word>KEY_PLUS</Word>
      <Word>KEY_MINUS</Word>
      <Word>KEY_C</Word>
      <Word>KEY_TAB</Word>
      <Word>KEY_OTHER</Word>
    </Keywords>

    <Rule color="Number">\b\d+(?:\.\d+)?(?:[eE][+\-]?\d+)?\b</Rule>
    <Rule color="Operator">&lt;&gt;|&lt;=|&gt;=|[=+\-*/();\[\],&lt;&gt;]</Rule>
  </RuleSet>
</SyntaxDefinition>
