<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Objective-C" extensions=".m" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="#0000FF" fontWeight="bold" />
  <Color name="Type" foreground="#267F99" />
  <Color name="String" foreground="#A31515" />
  <Color name="Comment" foreground="#008000" />
  <Color name="Number" foreground="#098658" />
  <Color name="Preprocessor" foreground="#AF00DB" />
  <Color name="Operator" foreground="#1F1F1F" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String" begin="@&quot;" end="&quot;" />
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="String" begin="'" end="'" />

    <Keywords color="Keyword">
      <Word>int</Word>
      <Word>return</Word>
      <Word>const</Word>
      <Word>void</Word>
      <Word>@autoreleasepool</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>NSString</Word>
      <Word>Foundation</Word>
    </Keywords>

    <Rule color="Preprocessor">^\s*#.*$</Rule>
    <Rule color="Number">\b\d+(\.\d+)?\b</Rule>
    <Rule color="Operator">[\[\]{}()+\-*/=;,.]</Rule>
  </RuleSet>
</SyntaxDefinition>
