<Window x:Class="SMILE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SMILE.Desktop"
        mc:Ignorable="d"
        Title="SMILE v0.1 - PRINT Everywhere"
        Height="820"
        Width="1180"
        MinHeight="620"
        MinWidth="900">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <DataTemplate DataType="{x:Type vm:TargetPaneViewModel}">
            <Border BorderBrush="#CFCFCF" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Width="230"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguageOption}"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                        <TextBlock Text="{Binding ToolchainStatusText}" TextWrapping="Wrap" />
                        <TextBlock Text="  " />
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Text="{Binding GeneratedCode}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy" Command="{Binding CopyCommand}" />
                        <Button Content="Save Source" Command="{Binding SaveSourceCommand}" />
                        <Button Content="{Binding BuildButtonText}" Command="{Binding BuildRunCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="New" Command="{Binding NewCommand}" />
                <Button Content="Open" Command="{Binding OpenCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Save As" Command="{Binding SaveAsCommand}" />
                <Button Content="Transpile All" Command="{Binding TranspileAllCommand}" />
                <Button Content="Build &amp; Run Visible Languages" Command="{Binding BuildRunVisibleCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding OperationStatus}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="210" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="210" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#CFCFCF" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SMILE" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Grid.Row="1"
                             Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <GridSplitter Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding Pane1}" />
            <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding Pane2}" />
            <ContentControl Grid.Row="2" Grid.Column="2" Content="{Binding Pane3}" />
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <Border Grid.Row="3" BorderBrush="#CFCFCF" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Diagnostics, Build, and Program Output"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBox Grid.Row="1"
                         Text="{Binding OutputText}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
